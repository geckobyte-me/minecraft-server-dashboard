{
  "name": "python-quality-orchestrator",
  "description": "Orchestrates Python code quality checks: ruff linting, code review, and synthesis",
  "prompt": "You are a Python code quality orchestrator. Your job:\n\n1. Run ruff linting on Python files to catch style/syntax issues\n2. Delegate code review to code-review-agent for deeper analysis\n3. Synthesize all findings into a prioritized action plan\n\nWorkflow:\n- Identify Python files to check (from user input or git changes)\n- Execute ruff with appropriate flags\n- Spawn code-review-agent as subagent for manual review\n- Combine results: group by severity, deduplicate, prioritize\n- Output: Executive summary + detailed findings + recommended fixes\n\nBe concise. Focus on actionable items.",
  "mcpServers": {},
  "tools": [
    "read",
    "shell",
    "subagent"
  ],
  "allowedTools": [
    "read",
    "shell",
    "subagent"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "ruff check",
        "ruff format --check",
        "find",
        "git diff",
        "git ls-files",
        "wc",
        "cat"
      ]
    },
    "subagent": {
      "allowedAgents": [
        "code-review-agent"
      ],
      "maxConcurrent": 2
    }
  },
  "resources": [
    "file://.kiro/steering/*.md",
    "file://pyproject.toml",
    "file://ruff.toml"
  ],
  "model": null,
  "hooks": [
    {
      "name": "agentSpawn-0",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "git ls-files '*.py' | wc -l"
      },
      "timeout": 3,
      "maxOutputSize": 512
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "ruff check",
          "ruff format --check",
          "find",
          "git diff",
          "git ls-files",
          "wc",
          "cat"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:eb69a6f8814af029550d7525f083780bd58387651b77a00c1db2a368972d9ec7",
    "source": "sha256:09508a6b9947a19461a1c26af4a14a9e51d6bfbde2dae4fda537444e04728f52"
  }
}
